rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidReservation(data) {
      return data.keys().hasAll(['guestName', 'email', 'phone', 'roomType', 'checkIn', 'nights', 'guests', 'status'])
        && data.guestName is string && data.guestName.size() >= 2 && data.guestName.size() <= 100
        && data.email is string && data.email.size() <= 120
        && data.phone is string && data.phone.size() >= 5 && data.phone.size() <= 30
        && data.roomType is string && data.roomType.size() <= 80
        && data.checkIn is string && data.checkIn.size() <= 20
        && data.nights is int && data.nights >= 1 && data.nights <= 60
        && data.guests is int && data.guests >= 1 && data.guests <= 20
        && data.status in ['pending', 'confirmed', 'cancelled'];
    }

    function isValidInquiry(data) {
      return data.keys().hasAll(['guestName', 'email', 'type'])
        && data.guestName is string && data.guestName.size() >= 2 && data.guestName.size() <= 100
        && data.email is string && data.email.size() <= 120
        && data.type in ['dining', 'general'];
    }

    // Reservations Collection
    match /reservations/{reservationId} {
      allow create: if isValidId(reservationId) && isValidReservation(request.resource.data);
      allow read: if request.auth != null;
    }

    // Inquiries Collection
    match /inquiries/{inquiryId} {
      allow create: if isValidId(inquiryId) && isValidInquiry(request.resource.data);
      allow read: if request.auth != null;
    }
  }
}
